# Postgres connection. Host dev uses the compose port mapping (5433);
# inside the ledgerly-dev container use postgres:5432. See DATABASE.md.
DATABASE_URL=postgresql://qbo:qbo@localhost:5433/ledgerly

# Required in production; sessions are Postgres-backed (connect-pg-simple).
SESSION_SECRET=change-me

NODE_ENV=development

# Optional: comma-separated origin whitelist for cross-origin browser access.
# Unset = CORS disabled (the SPA reaches the API same-origin via the Vite proxy).
# CORS_ORIGINS=https://app.example.com

# Optional: set to 1 to disable auth rate limiting (it is auto-disabled in tests).
# RATE_LIMIT_DISABLED=1
